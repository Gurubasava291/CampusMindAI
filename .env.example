# ==============================================================================
# CampusPulse DSU — Environment Configuration Template
# Dayananda Sagar University (DSU), Bengaluru, Karnataka, India
# ==============================================================================

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=dsu_campuspulse_super_secret_key_change_in_production_2026

# Campus Geolocation Defaults (Dayananda Sagar University - Main Innovation Campus)
# Harohalli Campus, Kanakapura Road, Ramanagara / Bengaluru South, Karnataka
CAMPUS_NAME=Dayananda Sagar University
CAMPUS_LOCATION=Bengaluru, Karnataka, India
DEFAULT_CAMPUS_LAT=12.6582
DEFAULT_CAMPUS_LNG=77.4475
DEFAULT_MAP_ZOOM=17

# Secondary City Campus (Kudlu Gate / Hosur Road, Bengaluru)
CITY_CAMPUS_LAT=12.8906
CITY_CAMPUS_LNG=77.6416

# AI Assistant & Categorization Service Configuration
# Optional: Supply Google Gemini or OpenAI API key for live LLM responses.
# If omitted or offline, the system uses a high-performance rule-based campus expert engine.
AI_PROVIDER=rule_based
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional passwords for seeded sample accounts. Use unique secrets.
# If omitted, seeded accounts receive random passwords and have no public default.
SEEDED_ADMIN_PASSWORD=
SEEDED_STAFF_PASSWORD=
SEEDED_STUDENT_PASSWORD=

# Gmail SMTP for password recovery emails (use a Google app password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.account@gmail.com
SMTP_PASSWORD=your_google_app_password
SMTP_FROM_EMAIL=your.account@gmail.com

# Upload Settings
MAX_CONTENT_LENGTH=16777216  # 16 MB in bytes
UPLOAD_FOLDER=static/uploads
ALLOWED_EXTENSIONS=png,jpg,jpeg,webp
